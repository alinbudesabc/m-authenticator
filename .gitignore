### gradle ###
# Local Gradle cache (do not ignore gradle/ wrapper or gradlew / gradlew.bat)
.gradle/
**/build/
!src/**/build/
# Ignore Gradle GUI config
gradle-app.setting
# Keep Gradle wrapper files trackable
!gradle/wrapper/gradle-wrapper.jar
!**/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!**/gradle-wrapper.properties
# Cache of project
.gradletasknamecache

